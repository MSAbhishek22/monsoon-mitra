# Monsoon Mitra — Environment Variables
# Copy this file to .env.local and fill in your values
# Never commit .env.local to git

# GEMINI — Server-side ONLY. Never use VITE_ prefix for this key.
# This goes in Vercel dashboard: Settings → Environment Variables
GEMINI_API_KEY=your_gemini_api_key_here

# FIREBASE — Safe to expose (protected by Firebase security rules)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# FIREBASE CLOUD MESSAGING — Get from Firebase Console → Project Settings → Cloud Messaging
VITE_FIREBASE_VAPID_KEY=your_vapid_key_here
